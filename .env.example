# Production domain
SITE_DOMAIN=YOUR_SERVER_IP_OR_DOMAIN

# PostgreSQL
POSTGRES_DB=vibyroom
POSTGRES_USER=vibyroom
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# Docker image
API_IMAGE=vibyroom-api:local

# GigaChat
GigaChat__AuthorizationKey=REPLACE_WITH_GIGACHAT_AUTHORIZATION_KEY
GigaChat__TimeoutSeconds=60

# Absolute path to trusted root CA certificate on production host
GIGACHAT_CA_CERT_PATH=/opt/vibyroom/certs/russian_trusted_root_ca_pem.crt