{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "DataProtection": {
    "ApplicationName": "VibyRoom"
  },
  "Rooms": {
    "Capacity": 20
  },
  "RoomQueue": {
    "MaxPendingItems": 100
  },
  "MusicProvider": {
    "Provider": "audius",
    "BaseUrl": "https://api.audius.co/v1/",
    "TimeoutSeconds": 15,
    "AllowedStreamRedirectHosts": [
      "validator.eeba4a6ca56a0d87af802270217c2a51.r2.cloudflarestorage.com"
    ]
  },
  "RateLimiting": {
    "RoomCreationPermitLimit": 5,
    "RoomCreationWindowSeconds": 60,
    "InvitationAccessPermitLimit": 30,
    "InvitationAccessWindowSeconds": 60,
    "MusicCatalogPermitLimit": 30,
    "MusicCatalogWindowSeconds": 60
  },
  "PlaybackProgression": {
    "IntervalMilliseconds": 1000,
    "BatchSize": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}