{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "DataProtection": {
    "ApplicationName": "VibyRoom"
  },
  "Rooms": {
    "Capacity": 20
  },
  "RateLimiting": {
    "RoomCreationPermitLimit": 5,
    "RoomCreationWindowSeconds": 60,
    "InvitationAccessPermitLimit": 30,
    "InvitationAccessWindowSeconds": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}